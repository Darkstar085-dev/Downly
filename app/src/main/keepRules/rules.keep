# Project-specific rules for classes accessed by reflection.
# Dependency-provided consumer rules are applied automatically by R8.
# Avoid broad keep rules to retain effective code shrinking.

-keepattributes Signature,*Annotation*

# Kotlin metadata may be inspected by reflection in runtime dependencies.
-keep class kotlin.Metadata { *; }

# Published yt-dlp wrappers/native helpers may be resolved by class name.
-keep class com.sipun.youtubedl_android.** { *; }
-keep class com.sipun.ffmpeg.** { *; }
-keep class com.sipun.aria2c.** { *; }
